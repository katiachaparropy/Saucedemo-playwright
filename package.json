{
  "name": "playwright-qa-demo",
  "version": "1.0.0",
  "description": "Playwright + TypeScript test automation framework (Page Object Model) with UI and API tests",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=chromium --project=firefox --project=webkit",
    "test:api": "playwright test --project=api",
    "test:smoke": "playwright test --grep @smoke",
    "test:headed": "playwright test --project=chromium --headed",
    "report": "playwright show-report",
    "lint": "tsc --noEmit"
  },
  "author": "Katia Chaparro",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^20.11.0",
    "typescript": "^5.4.0"
  }
}
